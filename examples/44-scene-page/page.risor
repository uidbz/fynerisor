require(["v0.10", "@gui", "@scene"])

let on_hello_tapped = (evt) => {
    page.Node("title").SetText("Hello from page.risor")
    page.Node("light").Set("fill", "#22c55e")
    print("page.risor handler ran for " + evt.id)
}

page.Node("title").SetText("Scene example — ready")

page.Bind({
    on_hello_tapped,
})
