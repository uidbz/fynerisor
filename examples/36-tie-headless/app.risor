require(["v0.7", "@tie"])

// Connect to tie daemon
let db = tie.connect("http://localhost:1161", {
    username: "defaultuser",
    password: "defaultpassword"
})

print("=== Adding documents with tags ===")
// Technical documents
db.add("rust-guide", "tag", "rust")
db.add("rust-guide", "tag", "programming")
db.add("rust-guide", "tag", "tutorial")
db.add("rust-guide", "author", "Alex Chen")

db.add("go-concurrency", "tag", "golang")
db.add("go-concurrency", "tag", "programming")
db.add("go-concurrency", "tag", "concurrency")
db.add("go-concurrency", "author", "Jordan Lee")

// Personal notes
db.add("vacation-2026", "tag", "personal")
db.add("vacation-2026", "tag", "travel")
db.add("vacation-2026", "tag", "photos")

db.add("recipe-sourdough", "tag", "personal")
db.add("recipe-sourdough", "tag", "cooking")
db.add("recipe-sourdough", "author", "Jamie Smith")

// Sync to ensure writes are committed
db.sync()
print("Writes synced")

print("\n=== Get a single document ===")
let rustGuide = db.get("rust-guide")
print("rust-guide:", rustGuide)

print("\n=== Query: what has 'programming' tag? (reverse query) ===")
// This works because 'tag' is in the default ReverseRelations list
let result = db.query({
    terms: ["programming"],
    reverse: true
})
print("Documents tagged 'programming':", result.rows)
print("Total count:", result.total_count)

print("\n=== Query: what has 'personal' tag? ===")
let personal = db.query({
    terms: ["personal"],
    reverse: true
})
print("Personal documents:", personal.rows)
print("Total count:", personal.total_count)

print("\n=== Expand multiple documents ===")
let docs = db.expand(["rust-guide", "vacation-2026"])
print("Multiple documents:", docs)

print("\n=== Batch operations ===")
let batch = db.batch()
batch.add("python-async", "tag", "python")
batch.add("python-async", "tag", "programming")
batch.add("python-async", "tag", "async")
batch.set("python-async", "author", ["Pat Wilson"])
batch.run()
print("Batch complete")

let pythonDoc = db.get("python-async")
print("python-async:", pythonDoc)

print("\n=== Exists check ===")
print("rust-guide exists:", db.exists("rust-guide"))
print("nonexistent exists:", db.exists("nonexistent"))

print("\n=== Update example ===")
db.update("rust-guide", "tag", "tutorial", "beginner")
let updated = db.get("rust-guide")
print("Updated rust-guide:", updated)

print("\nDone!")
