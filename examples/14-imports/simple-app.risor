// simple-app.risor - Main application using imported utilities

import("examples/14-imports/simple-utils.risor")
require("v0.5")

// Use imported greet function
let greeting = greet("World")
let greetingLabel = widget.NewLabel(greeting)

// Use imported math functions
let num = 5
let squared = square(num)
let cubed = cube(num)
let mathLabel = widget.NewLabel(`${num} squared = ${squared}, cubed = ${cubed}`)

// Use imported widget helper
let entry = widget.NewEntry()
entry.PlaceHolder = "Enter your name"

let labeledEntry = createLabeledWidget("Your Name:", entry)

// Button to test the greet function with entry value
let greetBtn = widget.NewButton("Greet", () => {
    if (entry.Text != "") {
        greetingLabel.Text = greet(entry.Text)
    }
})

// Calculator section using imported math
let num1Entry = widget.NewEntry()
num1Entry.PlaceHolder = "Number 1"

let num2Entry = widget.NewEntry()
num2Entry.PlaceHolder = "Number 2"

let resultLabel = widget.NewLabel("Result: ")

let addBtn = widget.NewButton("Add", () => {
    let a = int(num1Entry.Text)
    let b = int(num2Entry.Text)
    let result = add(a, b)
    resultLabel.Text = `Result: ${a} + ${b} = ${result}`
})

// Layout
let title = widget.NewLabel("Simple Imports Example")

let layout = container.NewVBox(
    title,
    widget.NewSeparator(),
    greetingLabel,
    widget.NewSeparator(),
    mathLabel,
    widget.NewSeparator(),
    labeledEntry,
    greetBtn,
    widget.NewSeparator(),
    widget.NewLabel("Calculator (using imported functions):"),
    num1Entry,
    num2Entry,
    addBtn,
    resultLabel
)

window.SetContent(container.NewScroll(layout))
