require(["v0.7", "@tie"])

// Connect to tie daemon
let db = tie.connect("http://localhost:1161", {
    username: "defaultuser",
    password: "defaultpassword"
})

// Seed some initial documents with tags
// Technical documents
db.add("rust-guide", "tag", "rust")
db.add("rust-guide", "tag", "programming")
db.add("rust-guide", "tag", "tutorial")

db.add("go-concurrency", "tag", "golang")
db.add("go-concurrency", "tag", "programming")
db.add("go-concurrency", "tag", "advanced")

db.add("python-async", "tag", "python")
db.add("python-async", "tag", "programming")
db.add("python-async", "tag", "async")

// Personal notes
db.add("vacation-2026", "tag", "personal")
db.add("vacation-2026", "tag", "travel")

db.add("recipe-sourdough", "tag", "personal")
db.add("recipe-sourdough", "tag", "cooking")

// Project notes
db.add("website-redesign", "tag", "project")
db.add("website-redesign", "tag", "frontend")
db.add("website-redesign", "tag", "urgent")

db.add("api-refactor", "tag", "project")
db.add("api-refactor", "tag", "backend")

db.sync()

// App state
let currentResults = []

function runQuery() {
    let queryTerm = queryEntry.Text
    if queryTerm == "" {
        setStatus("Enter a tag to search for (e.g., 'programming', 'personal', 'project')")
        return
    }

    setStatus("Querying for tag: " + queryTerm)

    let result = db.query({
        terms: [queryTerm],
        reverse: true  // Find what has this tag
    })

    currentResults = result.rows
    updateTable()
    setStatus("Found " + string(result.total_count) + " documents tagged '" + queryTerm + "' (showing " + string(len(result.rows)) + ")")
}

function updateTable() {
    let data = currentResults.map(row => {
        let attrs = []
        for k in row.attributes.keys().sort() {
            let values = row.attributes[k].join(", ")
            attrs.append(k + ": " + values)
        }
        return [row.key, attrs.join("; ")]
    })

    tableData.UpdateData(data)
    table.Refresh()
}

function addTriple() {
    let key = keyEntry.Text
    let rel = relationEntry.Text
    let val = valueEntry.Text

    if key == "" || rel == "" || val == "" {
        setStatus("ERROR: All fields required (key, relation, value)")
        return
    }

    db.add(key, rel, val)
    db.sync()

    setStatus("Added: " + key + " | " + rel + " | " + val)

    // Clear the form
    keyEntry.SetText("")
    relationEntry.SetText("")
    valueEntry.SetText("")

    // Refresh if the current query would include this
    if queryEntry.Text != "" {
        runQuery()
    }
}

// Build UI
let window = app.NewWindow("Tie Document Browser")
window.Resize(fyne.NewSize(800, 600))

// Query section
let queryLabel = widget.NewLabel("Search by tag:")
let queryEntry = widget.NewEntry()
queryEntry.SetPlaceHolder("Enter tag (e.g., 'programming', 'personal', 'project')")

let queryButton = widget.NewButton("Search", () => {
    runQuery()
})

let queryBox = container.NewBorder(
    nil, nil,
    queryLabel,
    queryButton,
    queryEntry
)

// Results table
let tableData = binding.NewTableData([
    ["key", "attributes"]
])

let table = widget.NewTableWithData(tableData)
table.SetColumnWidth(0, 150)
table.SetColumnWidth(1, 600)

let tableLabel = widget.NewLabel("Results:")
let tableBox = container.NewBorder(
    tableLabel, nil, nil, nil,
    table
)

// Add triple form
let addLabel = widget.NewLabel("Add document with tag:")
let keyEntry = widget.NewEntry()
keyEntry.SetPlaceHolder("document-name")
let relationEntry = widget.NewEntry()
relationEntry.SetPlaceHolder("tag")
relationEntry.SetText("tag")  // Default to "tag" relation
let valueEntry = widget.NewEntry()
valueEntry.SetPlaceHolder("tag-value")

let addButton = widget.NewButton("Add", () => {
    addTriple()
})

let formBox = container.NewHBox(
    keyEntry,
    widget.NewLabel("|"),
    relationEntry,
    widget.NewLabel("|"),
    valueEntry,
    addButton
)

let addBox = container.NewBorder(
    addLabel, nil, nil, nil,
    formBox
)

// Main layout
let content = container.NewBorder(
    container.NewVBox(queryBox, widget.NewSeparator()),
    container.NewVBox(widget.NewSeparator(), addBox),
    nil, nil,
    tableBox
)

window.SetContent(content)

setStatus("Connected to tie daemon. Try querying for 'programming', 'personal', or 'project'.")
