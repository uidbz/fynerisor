{
  "format": "fynerisor.scene/1",
  "id": "customers",
  "title": "v3 customers",
  "root": {
    "id": "root",
    "type": "vbox",
    "children": [
      {
        "id": "title",
        "type": "label",
        "props": {"text": "Customers", "bold": true}
      },
      {
        "id": "form",
        "type": "form",
        "children": [
          {
            "id": "name-field",
            "type": "field",
            "props": {"label": "Name"},
            "children": [{"id": "name", "type": "entry"}]
          },
          {
            "id": "city-field",
            "type": "field",
            "props": {"label": "City"},
            "children": [{"id": "city", "type": "entry"}]
          }
        ]
      },
      {
        "id": "buttons",
        "type": "hbox",
        "children": [
          {"id": "add", "type": "button", "props": {"text": "Add"}},
          {"id": "refresh", "type": "button", "props": {"text": "Refresh"}}
        ]
      },
      {
        "id": "table",
        "type": "table",
        "props": {
          "title": "Customers",
          "columns": ["Name", "City", "Active"]
        }
      },
      {
        "id": "log",
        "type": "log",
        "props": {"text": "ready"}
      }
    ]
  }
}
